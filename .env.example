# Порт для HTTP сервера (Fly.io встановлює автоматично)
PORT=8080

# Шлях до бази даних SQLite
# Для локальної розробки: finance-bot.db
# На Fly.io (якщо примонтовано Volume у /data): /data/finance-bot.db
DB_PATH=finance-bot.db

# Налаштування Monobank API
# Токен можна отримати на https://api.monobank.ua/
MONOBANK_TOKEN=your_monobank_token_here
# ID рахунку Monobank, виписку якого потрібно аналізувати (або "0" для дефолтного/першого)
MONOBANK_ACCOUNT_ID=your_monobank_account_id_here

# Налаштування Telegram Bot API
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Ваш особистий Telegram Chat ID (куди бот надсилатиме повідомлення)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Налаштування Gemini AI API (від Google)
# Ключ можна отримати в Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
